---
// Public Turnstile site key (safe to expose). Replace with yours from the Cloudflare dashboard.
const TURNSTILE_SITE_KEY = '0x4AAAAAAFKeDlI-VOaNeu_R';
---

<section id="contact" class="border-t border-zinc-800 px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
	<div class="max-w-2xl mx-auto">
		<h2 class="font-display text-3xl font-semibold tracking-tight text-center">Request a quote</h2>
		<p class="mt-3 text-zinc-400 text-center">
			Tell us about your project. Every inquiry gets a personal response with next steps and,
			when the scope is clear, a written quote.
		</p>

		<form id="contact-form" action="/api/contact" method="POST" class="mt-8 space-y-5 sm:mt-10">
			<input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
			<div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
				<div>
					<label for="name" class="block text-sm text-zinc-300 mb-1">Name</label>
					<input
						type="text"
						id="name"
						name="name"
						required
						class="w-full rounded-lg bg-zinc-900 border border-zinc-700 px-4 py-2.5 text-sm focus:border-orange-500 focus:outline-none"
					/>
				</div>
				<div>
					<label for="email" class="block text-sm text-zinc-300 mb-1">Email</label>
					<input
						type="email"
						id="email"
						name="email"
						required
						class="w-full rounded-lg bg-zinc-900 border border-zinc-700 px-4 py-2.5 text-sm focus:border-orange-500 focus:outline-none"
					/>
				</div>
			</div>
			<div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
				<div>
					<label for="project-type" class="block text-sm text-zinc-300 mb-1">Service</label>
					<select
						id="project-type"
						name="project-type"
						class="w-full rounded-lg bg-zinc-900 border border-zinc-700 px-4 py-2.5 text-sm focus:border-orange-500 focus:outline-none"
					>
						<option>CAD design</option>
						<option>3D printing</option>
						<option>Product development</option>
						<option>Something else</option>
					</select>
				</div>
				<div>
					<label for="timeline" class="block text-sm text-zinc-300 mb-1">Timeline</label>
					<select
						id="timeline"
						name="timeline"
						class="w-full rounded-lg bg-zinc-900 border border-zinc-700 px-4 py-2.5 text-sm focus:border-orange-500 focus:outline-none"
					>
						<option>Flexible</option>
						<option>Within a month</option>
						<option>Within two weeks</option>
						<option>Urgent</option>
					</select>
				</div>
			</div>
			<div>
				<label for="message" class="block text-sm text-zinc-300 mb-1">Project details</label>
				<textarea
					id="message"
					name="message"
					rows="5"
					required
					placeholder="What should it do, roughly how big is it, and how many do you need?"
					class="w-full rounded-lg bg-zinc-900 border border-zinc-700 px-4 py-2.5 text-sm focus:border-orange-500 focus:outline-none"
				></textarea>
			</div>
			<div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-action="contact" data-theme="dark" data-callback="onTurnstileSuccess" data-expired-callback="onTurnstileLost" data-error-callback="onTurnstileLost" data-timeout-callback="onTurnstileLost"></div>
			<button
				type="submit"
				class="w-full rounded-full bg-orange-500 px-6 py-3 text-sm font-medium text-zinc-950 hover:bg-orange-400 transition-colors disabled:cursor-not-allowed disabled:opacity-50"
			>
				Request a quote
			</button>
			<p id="form-status" role="status" class="text-center text-sm min-h-5"></p>
		</form>

		<p class="mt-6 text-center text-sm text-zinc-500">
			Prefer to reach out directly? Message{' '}
			<a href="https://www.instagram.com/refinery.st/" target="_blank" rel="noopener noreferrer" class="text-orange-500 hover:text-orange-400">@refinery.st</a>{' '}
			or email{' '}
			<a href="mailto:refinery.st@gmail.com" class="text-orange-500 hover:text-orange-400">refinery.st@gmail.com</a>.
		</p>
	</div>
</section>

<script is:inline>
	// Defined before the Turnstile script loads so its callbacks resolve by name.
	(function () {
		var button = document.querySelector('#contact-form button[type="submit"]');
		var setReady = function (ready) {
			button.disabled = !ready;
		};
		window.onTurnstileSuccess = function () { setReady(true); };
		window.onTurnstileLost = function () { setReady(false); };

		var form = document.getElementById('contact-form');
		var status = document.getElementById('form-status');
		setReady(false);

		form.addEventListener('submit', async function (e) {
			e.preventDefault();
			if (button.disabled) return;
			setReady(false);
			status.className = 'text-center text-sm min-h-5 text-zinc-400';
			status.textContent = 'Sending…';
			try {
				var res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
				var data = await res.json().catch(function () { return {}; });
				if (!res.ok) throw new Error(data.error || 'Something went wrong.');
				form.reset();
				status.className = 'text-center text-sm min-h-5 text-green-400';
				status.textContent = "Thanks, your inquiry was received. We'll be in touch soon.";
			} catch (err) {
				status.className = 'text-center text-sm min-h-5 text-red-400';
				status.textContent = err instanceof Error ? err.message : 'Something went wrong.';
			} finally {
				// Tokens are single-use: the button stays disabled until a fresh one arrives.
				if (window.turnstile) window.turnstile.reset();
			}
		});
	})();
</script>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
