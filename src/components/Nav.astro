---
const links = [
	{ href: '#services', label: 'Services' },
	{ href: '#products', label: 'Products' },
	{ href: '#process', label: 'How it works' },
	{ href: '#about', label: 'About' },
	{ href: '#faq', label: 'FAQ' },
	{ href: '#contact', label: 'Contact' },
];
---

<header class="fixed top-0 inset-x-0 z-50 backdrop-blur bg-zinc-950/80 border-b border-zinc-800">
	<nav class="relative max-w-6xl mx-auto flex items-center justify-between gap-3 px-4 py-3 sm:px-6 sm:py-4">
		<a href="#" class="font-display text-lg font-semibold tracking-tight">
			Refinery<span class="text-orange-500">.st</span>
		</a>
		<ul class="hidden md:flex items-center gap-8 text-sm text-zinc-300">
			{links.map((link) => (
				<li>
					<a href={link.href} class="hover:text-white transition-colors">{link.label}</a>
				</li>
			))}
		</ul>
		<a
			href="#contact"
			class="hidden md:inline-flex rounded-full bg-orange-500 px-4 py-2 text-sm font-medium text-zinc-950 hover:bg-orange-400 transition-colors"
		>
			Request a quote
		</a>
		<details class="relative md:hidden" data-mobile-menu>
			<summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full border border-zinc-700 text-zinc-100 hover:border-zinc-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-500">
				<span class="sr-only">Open navigation menu</span>
				<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-5 w-5 stroke-current" stroke-width="1.8">
					<path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
				</svg>
			</summary>
			<div class="absolute right-0 top-[calc(100%+0.75rem)] w-[min(20rem,calc(100vw-2rem))] rounded-2xl border border-zinc-800 bg-zinc-950 p-3 shadow-xl">
				<ul class="space-y-1 text-sm text-zinc-200">
					{links.map((link) => (
						<li>
							<a href={link.href} class="block rounded-xl px-4 py-3 hover:bg-zinc-900 hover:text-white focus-visible:outline-2 focus-visible:outline-orange-500">
								{link.label}
							</a>
						</li>
					))}
				</ul>
				<a
					href="#contact"
					class="mt-2 flex min-h-11 items-center justify-center rounded-full bg-orange-500 px-4 py-2 text-sm font-medium text-zinc-950 hover:bg-orange-400"
				>
					Request a quote
				</a>
			</div>
		</details>
	</nav>
</header>

<script>
	const mobileMenu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');

	mobileMenu?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => {
			mobileMenu.open = false;
		});
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && mobileMenu?.open) {
			mobileMenu.open = false;
			mobileMenu.querySelector('summary')?.focus();
		}
	});
</script>
