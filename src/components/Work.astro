---
const base = import.meta.env.BASE_URL;
const projects = [
	{
		title: 'Project 1',
		tag: 'CAD / Prototype',
		description: 'Placeholder — swap in your first featured build with photos and a short writeup.',
		image: `${base}images/work/project-1.jpg`,
	},
	{
		title: 'Project 2',
		tag: 'Product Design',
		description: 'Placeholder — swap in your second featured build.',
		image: `${base}images/work/project-2.jpg`,
	},
	{
		title: 'Project 3',
		tag: '3D Print',
		description: 'Placeholder — swap in your third featured build.',
		image: `${base}images/work/project-3.jpg`,
	},
];
---

<section id="work" class="px-6 py-24 border-t border-zinc-800">
	<div class="max-w-6xl mx-auto">
		<h2 class="font-display text-3xl font-semibold tracking-tight">Work</h2>
		<p class="mt-3 text-zinc-400 max-w-xl">
			Featured builds, prototypes, and assemblies. More on
			<a
				href="https://www.instagram.com/refinery.st/"
				target="_blank"
				rel="noopener noreferrer"
				class="text-orange-500 hover:text-orange-400"
			>@refinery.st</a>.
		</p>
		<div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
			{projects.map((project) => (
				<article class="rounded-2xl overflow-hidden border border-zinc-800 hover:border-zinc-600 transition-colors">
					<div class="aspect-video bg-zinc-800 overflow-hidden">
						<img
							src={project.image}
							alt={project.title}
							loading="lazy"
							class="w-full h-full object-cover"
							onerror="this.closest('.aspect-video').classList.add('flex','items-center','justify-center'); this.replaceWith(Object.assign(document.createElement('span'), {className: 'text-zinc-600 text-sm', textContent: 'Image coming soon'}))"
						/>
					</div>
					<div class="p-5">
						<p class="text-xs uppercase tracking-wide text-orange-500">{project.tag}</p>
						<h3 class="font-display mt-1 font-semibold">{project.title}</h3>
						<p class="mt-2 text-sm text-zinc-400 leading-relaxed">{project.description}</p>
					</div>
				</article>
			))}
		</div>
	</div>
</section>
