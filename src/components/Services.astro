---
const services = [
	{
		icon: '◧',
		title: 'CAD Design & Engineering',
		description: 'Production-ready 3D models for parts, mechanisms, and complete products.',
		includes: [
			'Parametric models built for fast, reliable revisions',
			'Assemblies, joints, and moving mechanisms',
			'Manufacturing-ready files (STEP, STL)',
			'Reverse engineering from a sample or measurements',
		],
	},
	{
		icon: '▤',
		title: '3D Printing & Prototyping',
		description: 'Functional prototypes and finished parts, printed and finished in-house.',
		includes: [
			'Fit and function test prints',
			'Rigid and flexible materials matched to the application',
			'Tolerances tuned for mating and moving parts',
			'Post-processing and finishing',
		],
	},
	{
		icon: '◩',
		title: 'Product Development',
		description: 'End-to-end development, from first concept to a product ready to sell.',
		includes: [
			'Concept development and requirements',
			'Iterative prototyping and testing',
			'Design for manufacture, whether 3D printing or injection molding',
			'One-off builds and small-batch production',
		],
	},
];
---

<section id="services" class="border-t border-zinc-800 px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
	<div class="max-w-6xl mx-auto">
		<h2 class="font-display text-3xl font-semibold tracking-tight">Services</h2>
		<p class="mt-3 text-zinc-400 max-w-xl">
			Engage us for a single stage or the entire process, from idea to physical product.
		</p>
		<div class="mt-8 grid grid-cols-1 gap-5 sm:mt-12 sm:grid-cols-2 sm:gap-8 lg:grid-cols-3">
			{services.map((service) => (
				<div class="rounded-2xl border border-zinc-800 p-6 hover:border-zinc-600 transition-colors sm:p-8">
					<span class="text-2xl text-orange-500" aria-hidden="true">{service.icon}</span>
					<h3 class="font-display mt-4 text-lg font-semibold">{service.title}</h3>
					<p class="mt-2 text-sm text-zinc-400 leading-relaxed">{service.description}</p>
					<ul class="mt-5 space-y-2 text-sm text-zinc-300">
						{service.includes.map((item) => (
							<li class="flex gap-3">
								<span class="text-orange-500" aria-hidden="true">✓</span>
								<span>{item}</span>
							</li>
						))}
					</ul>
				</div>
			))}
		</div>
	</div>
</section>
