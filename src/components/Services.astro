---
const services = [
	{
		icon: '◧',
		title: 'CAD Design',
		description:
			'Parametric modeling for functional parts, mechanisms, and product prototypes — built to print or manufacture, not just render.',
	},
	{
		icon: '▤',
		title: '3D Printing',
		description:
			'FDM printing from a finished model to a finished part: material selection, tolerances, post-processing, and iteration.',
	},
	{
		icon: '◨',
		title: 'App / Site / Tool Building',
		description:
			'Software to go with the physical side — product sites, internal tools, or a small app that a product idea actually needs.',
	},
	{
		icon: '◩',
		title: 'Product Development',
		description:
			'End-to-end: concept, CAD, prototype, revisions, and a small-batch or one-off finished product.',
	},
];
---

<section id="services" class="px-6 py-24 border-t border-zinc-800">
	<div class="max-w-6xl mx-auto">
		<h2 class="font-display text-3xl font-semibold tracking-tight">Services</h2>
		<p class="mt-3 text-zinc-400 max-w-xl">
			Hire me for one piece of the process or the whole thing, from idea to physical product.
		</p>
		<div class="mt-12 grid grid-cols-1 sm:grid-cols-2 gap-8">
			{services.map((service) => (
				<div class="rounded-2xl border border-zinc-800 p-6 hover:border-zinc-600 transition-colors">
					<span class="text-2xl text-orange-500" aria-hidden="true">{service.icon}</span>
					<h3 class="font-display mt-4 text-lg font-semibold">{service.title}</h3>
					<p class="mt-2 text-sm text-zinc-400 leading-relaxed">{service.description}</p>
				</div>
			))}
		</div>
	</div>
</section>
