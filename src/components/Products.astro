---
const base = import.meta.env.BASE_URL;
const products = [
	{
		name: 'Dog Bag Holder',
		description: 'Clip-on poop bag dispenser for a leash or harness.',
		image: `${base}images/products/dog-bag-holder.jpg`,
	},
	{
		name: 'Pet Statue',
		description: 'Custom sculpted likeness of a pet — statue or vase form.',
		image: `${base}images/products/pet-statue.jpg`,
	},
	{
		name: 'Pet Name Tag',
		description: 'Custom-engraved tag, sized and shaped to the pet.',
		image: `${base}images/products/pet-name-tag.jpg`,
	},
	{
		name: 'Eyelash Curler',
		description: 'Ergonomic redesign of an everyday tool.',
		image: `${base}images/products/eyelash-curler.jpg`,
	},
	{
		name: 'Pendant Light Shade',
		description: 'Printed shade designed for even light diffusion and a practical print time.',
		image: `${base}images/products/light-pendant.jpg`,
	},
];
---

<section id="products" class="border-t border-zinc-800 bg-zinc-900/30 px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
	<div class="max-w-6xl mx-auto">
		<h2 class="font-display text-3xl font-semibold tracking-tight">Products</h2>
		<p class="mt-3 text-zinc-400 max-w-xl">
			Original products designed and made in-house. Available to order as-is, customized, or as
			a starting point for your own product.
		</p>
		<div class="mt-8 grid grid-cols-1 gap-5 sm:mt-12 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
			{products.map((product) => (
				<div class="group rounded-2xl overflow-hidden border border-zinc-800 hover:border-zinc-600 transition-colors">
					<div class="aspect-square bg-zinc-800 overflow-hidden">
						<img
							src={product.image}
							alt={`${product.name}, designed and 3D printed by Refinery.st`}
							loading="lazy"
							class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
							onerror="this.closest('.aspect-square').classList.add('flex','items-center','justify-center'); this.replaceWith(Object.assign(document.createElement('span'), {className: 'text-zinc-600 text-sm', textContent: 'Image coming soon'}))"
						/>
					</div>
					<div class="p-5">
						<h3 class="font-display font-semibold">{product.name}</h3>
						<p class="mt-1 text-sm text-zinc-400">{product.description}</p>
					</div>
				</div>
			))}
			<a
				href="#contact"
				class="rounded-2xl border border-dashed border-zinc-700 hover:border-orange-500 transition-colors flex flex-col items-center justify-center text-center p-6 min-h-[220px]"
			>
				<span class="text-3xl text-orange-500">+</span>
				<span class="mt-3 font-display font-semibold">Have your own idea?</span>
				<span class="mt-1 text-sm text-zinc-400">We'll design and build it.</span>
			</a>
		</div>
	</div>
</section>
