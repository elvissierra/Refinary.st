---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Refinery.st | Product Design, CAD & 3D Printing Studio',
	description = 'Refinery.st is a product design studio offering parametric CAD, 3D printed prototypes, and small-batch production. Request a quote for your project.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const sameAs = [
	'https://www.instagram.com/refinery.st/',
];
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Person',
			'@id': `${Astro.site}#elvis`,
			name: 'Elvis Sierra',
			jobTitle: 'Founder, Refinery.st',
			url: Astro.site?.toString(),
			sameAs,
			knowsAbout: [
				'Parametric CAD',
				'Fusion 360',
				'FDM 3D printing',
				'Product development',
			],
		},
		{
			'@type': 'ProfessionalService',
			'@id': `${Astro.site}#studio`,
			name: 'Refinery.st',
			url: Astro.site?.toString(),
			description,
			founder: { '@id': `${Astro.site}#elvis` },
			email: 'refinery.st@gmail.com',
			sameAs: [sameAs[0]],
			serviceType: ['CAD design', '3D printing', 'Product development'],
		},
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content="Refinery.st" />
		<meta name="author" content="Elvis Sierra" />
		<link rel="canonical" href={canonical} />
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body class="bg-zinc-950 text-zinc-100 font-sans antialiased">
		<slot />
	</body>
</html>

<style is:global>
	html {
		scroll-behavior: smooth;
	}
	body {
		font-family: 'Inter', system-ui, sans-serif;
	}
	.font-display {
		font-family: 'Space Grotesk', 'Inter', system-ui, sans-serif;
	}
</style>
